<?xml version="1.0" encoding="UTF-8"?>
<as:AppSchemaDataAccess
    xmlns:as="http://www.geotools.org/app-schema"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.geotools.org/app-schema AppSchemaDataAccess.xsd">

  <namespaces>
    <Namespace>
      <prefix>ex</prefix>
      <uri>http://example.com/inspire-curve-repro</uri>
    </Namespace>
    <Namespace>
      <prefix>gml</prefix>
      <uri>http://www.opengis.net/gml/3.2</uri>
    </Namespace>
  </namespaces>

  <sourceDataStores>
    <DataStore>
      <id>shapefile</id>
      <parameters>
        <Parameter>
          <name>url</name>
          <value>file:./multipart_curve.shp</value>
        </Parameter>
        <Parameter>
          <name>memory mapped buffer</name>
          <value>false</value>
        </Parameter>
        <Parameter>
          <name>create spatial index</name>
          <value>true</value>
        </Parameter>
        <Parameter>
          <name>charset</name>
          <value>UTF-8</value>
        </Parameter>
      </parameters>
    </DataStore>
  </sourceDataStores>

  <targetTypes>
    <FeatureType>
      <schemaUri>./curve-feature.xsd</schemaUri>
    </FeatureType>
  </targetTypes>

  <typeMappings>
    <FeatureTypeMapping>
      <sourceDataStore>shapefile</sourceDataStore>
      <sourceType>multipart_curve</sourceType>
      <targetElement>ex:CurveFeature</targetElement>

      <attributeMappings>
        <AttributeMapping>
          <targetAttribute>ex:CurveFeature</targetAttribute>
          <idExpression>
            <OCQL>strConcat('CurveFeature.', ID)</OCQL>
          </idExpression>
        </AttributeMapping>

        <AttributeMapping>
          <targetAttribute>ex:name</targetAttribute>
          <sourceExpression>
            <OCQL>NAME</OCQL>
          </sourceExpression>
        </AttributeMapping>

        <AttributeMapping>
          <targetAttribute>ex:geometry</targetAttribute>
          <idExpression>
            <OCQL>strConcat('CurveGeometry.', ID)</OCQL>
          </idExpression>
          <sourceExpression>
            <OCQL>the_geom</OCQL>
          </sourceExpression>
        </AttributeMapping>
      </attributeMappings>
    </FeatureTypeMapping>
  </typeMappings>
</as:AppSchemaDataAccess>
